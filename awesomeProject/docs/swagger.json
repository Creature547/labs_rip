  "definitions": {
    "Equipment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "power": {
          "type": "number"
        },
        "cost": {
          "type": "number"
        },
        "image_url": {
          "type": "string"
        },
        "video_url": {
          "type": "string"
        },
        "is_creator": {
          "type": "integer"
        },
        "liked": {
          "type": "integer"
        },
        "likes_count": {
          "type": "integer"
        }
      }
    },
    "User": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "login": {
          "type": "string"
        }
      }
    },
    "Credentials": {
      "type": "object",
      "properties": {
        "login": {
          "type": "string",
          "example": "anna_lab4"
        },
        "password": {
          "type": "string",
          "example": "lab4pass"
        }
      },
      "required": [
        "login",
        "password"
      ]
    },
    "Like": {
      "type": "object",
      "properties": {
        "like": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        }
      },
      "required": [
        "like"
      ]
    },
    "Publication": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "power": {
          "type": "number"
        },
        "cost": {
          "type": "number"
        },
        "image_url": {
          "type": "string"
        },
        "video_url": {
          "type": "string"
        },
        "is_creator": {
          "type": "integer"
        },
        "liked": {
          "type": "integer"
        },
        "likes_count": {
          "type": "integer"
        },
        "status": {
          "type": "string",
          "enum": [
            "опубликован"
          ]
        },
        "formed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "AuthResponse": {
      "type": "object",
      "properties": {
        "access_token": {
          "type": "string"
        },
        "token_type": {
          "type": "string",
          "example": "Bearer"
        },
        "expires_in": {
          "type": "integer",
          "example": 3600
        },
        "user": {
          "$ref": "#/definitions/User"
        }
      }
    }
  }
