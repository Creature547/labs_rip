          },
          "401": {
            "description": "JWT отсутствует, неверен, истёк или заблокирован"
          },
          "503": {
            "description": "Redis недоступен"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/heating-equipment/{id}/publish": {
      "put": {
        "summary": "Опубликовать свой черновик",
        "description": "Меняет status на опубликован и заполняет formed_at. Тело не нужно. Чужой или уже опубликованный прибор — 404.",
        "operationId": "Publish",
        "tags": [
          "Приборы"
        ],
        "responses": {
          "200": {
            "description": "Успех",
            "schema": {
              "$ref": "#/definitions/Publication"
            }
          },
          "400": {
            "description": "Неверные параметры"
          },
          "404": {
            "description": "Не найдено"
          },
          "500": {
            "description": "Ошибка сервера"
          },
          "401": {
            "description": "JWT отсутствует, неверен, истёк или заблокирован"
          },
          "503": {
            "description": "Redis недоступен"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "type": "integer",
            "required": true,
            "description": "Идентификатор прибора"
          }
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
