    "/heating-equipment/feed": {
      "get": {
        "summary": "Первый прибор в ленте",
        "description": "",
        "operationId": "Feed",
        "tags": [
          "Приборы"
        ],
        "responses": {
          "200": {
            "description": "Успех",
            "schema": {
              "$ref": "#/definitions/Equipment"
            }
          },
          "400": {
            "description": "Неверные параметры"
          },
          "404": {
            "description": "Не найдено"
          },
          "500": {
            "description": "Ошибка сервера"
          }
        }
      }
    },
    "/heating-equipment/feed/{id}": {
      "get": {
        "summary": "Прибор по ID или следующий",
        "description": "next=true возвращает следующий по ID; после последнего — первый.",
        "operationId": "FeedByID",
        "tags": [
          "Приборы"
        ],
        "responses": {
          "200": {
            "description": "Успех",
            "schema": {
