{
  "swagger": "2.0",
  "info": {
    "title": "Отопительные приборы — ЛР4",
    "version": "4.0",
    "description": "Go / Gin / PostgreSQL / MinIO / Redis. В Authorize вводить Bearer и JWT через пробел. Гостю доступны опубликованные приборы и лента. Регистрация и вход открыты."
  },
  "basePath": "/api",
  "schemes": [
    "http"
  ],
  "produces": [
    "application/json"
  ],
  "securityDefinitions": {
    "BearerAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Bearer <access_token>"
    }
  },
  "paths": {
    "/users": {
      "post": {
        "summary": "Регистрация",
        "description": "",
        "operationId": "Register",
        "tags": [
          "Пользователи"
        ],
        "responses": {
          "201": {
            "description": "Успех",
            "schema": {
              "$ref": "#/definitions/User"
            }
          },
          "400": {
            "description": "Неверные параметры"
          },
          "404": {
            "description": "Не найдено"
          },
          "500": {
            "description": "Ошибка сервера"
          },
          "409": {
            "description": "Логин занят"
          }
        },
        "parameters": [
          {
            "name": "credentials",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Credentials"
            }
          }
        ],
        "consumes": [
          "application/json"
        ]
      }
    },
    "/users/auth": {
      "post": {
        "summary": "Вход — получить JWT",
        "description": "",
        "operationId": "Authenticate",
        "tags": [
          "Пользователи"
        ],
        "responses": {
          "200": {
            "description": "Успех",
            "schema": {
              "$ref": "#/definitions/AuthResponse"
            }
          },
          "400": {
            "description": "Неверные параметры"
          },
          "404": {
            "description": "Не найдено"
          },
          "500": {
            "description": "Ошибка сервера"
          },
          "401": {
            "description": "Неверный логин или пароль"
          }
        },
        "parameters": [
          {
            "name": "credentials",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Credentials"
            }
          }
        ],
        "consumes": [
          "application/json"
        ]
      }
    },
    "/users/logout": {
      "post": {
        "summary": "Выход — заблокировать текущий JWT",
        "description": "В Redis создаётся blacklist:<jti>, значение — login, TTL — оставшееся время жизни JWT.",
        "operationId": "Logout",
        "tags": [
          "Пользователи"
        ],
        "responses": {
          "200": {
            "description": "Успех"
          },
          "400": {
            "description": "Неверные параметры"
          },
          "404": {
            "description": "Не найдено"
          },
          "500": {
            "description": "Ошибка сервера"
          },
          "401": {
            "description": "JWT отсутствует, неверен, истёк или заблокирован"
          },
          "503": {
            "description": "Redis недоступен"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/heating-equipment": {
      "get": {
        "summary": "Список опубликованных приборов с фильтром",
        "description": "Доступен гостю и с любым токеном. Невалидный токен считается гостевым режимом.",
        "operationId": "List",
        "tags": [
          "Приборы"
        ],
        "responses": {
          "200": {
            "description": "Успех",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Equipment"
              }
            }
          },
          "400": {
            "description": "Неверные параметры"
          },
          "404": {
            "description": "Не найдено"
          },
          "500": {
            "description": "Ошибка сервера"
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "type": "string",
            "required": false,
            "description": ""
          },
          {
            "name": "min_power",
            "in": "query",
            "type": "number",
            "required": false,
            "description": ""
          },
          {
            "name": "max_cost",
            "in": "query",
            "type": "number",
            "required": false,
            "description": ""
          }
        ]
      },
      "post": {
        "summary": "Создать черновик с фото и видео",
        "description": "creator_id берётся из проверенного JWT. power и cost больше нуля. Один черновик на пользователя.",
        "operationId": "CreateDraft",
        "tags": [
          "Приборы"
        ],
        "responses": {
          "201": {
            "description": "Успех",
            "schema": {
              "$ref": "#/definitions/Equipment"
            }
          },
          "400": {
            "description": "Неверные параметры"
          },
          "404": {
            "description": "Не найдено"
          },
          "500": {
            "description": "Ошибка сервера"
          },
          "401": {
            "description": "JWT отсутствует, неверен, истёк или заблокирован"
          },
          "503": {
            "description": "Redis недоступен"
          },
          "409": {
            "description": "У пользователя уже есть черновик"
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "formData",
            "type": "string",
            "required": true,
            "description": ""
          },
          {
            "name": "description",
            "in": "formData",
            "type": "string",
            "required": false,
            "description": ""
          },
          {
            "name": "power",
            "in": "formData",
            "type": "number",
            "required": true,
            "description": ""
          },
          {
            "name": "cost",
            "in": "formData",
            "type": "number",
            "required": true,
            "description": ""
          },
          {
            "name": "image",
            "in": "formData",
            "type": "file",
            "required": true,
            "description": ""
          },
          {
            "name": "video",
            "in": "formData",
            "type": "file",
            "required": true,
            "description": ""
          }
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "consumes": [
          "multipart/form-data"
        ]
      }
    },
    "/heating-equipment/draft": {
      "get": {
        "summary": "Получить свой черновик",
        "description": "",
        "operationId": "Draft",
        "tags": [
