        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "type": "integer",
            "required": true,
            "description": "Идентификатор прибора"
          },
          {
            "name": "next",
            "in": "query",
            "type": "boolean",
            "required": false,
            "description": ""
          }
        ]
      }
    }
