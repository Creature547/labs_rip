classDiagram
    direction LR

    class CatalogPage {
        <<page>>
    }
    class FeedPage {
        <<page>>
    }
    class DraftPage {
        <<page>>
    }
    class RegistrationPage {
        <<page>>
    }

    class EquipmentDomain {
        <<interface>>
        +List()
        +CreateDraft()
        +GetDraft()
        +Publish()
        +Delete()
        +Like()
        +Feed()
        +FeedByID()
    }
    note for EquipmentDomain "GET /api/heating-equipment; POST /api/heating-equipment; GET /api/heating-equipment/draft; PUT /api/heating-equipment/:id/publish; DELETE /api/heating-equipment/:id; POST /api/heating-equipment/:id/like; GET /api/heating-equipment/feed; GET /api/heating-equipment/feed/:id?next=true"

    class UserDomain {
        <<interface>>
        +Register()
        +Authenticate()
        +Logout()
    }
    note for UserDomain "POST /api/users; POST /api/users/auth; POST /api/users/logout"

    class HeatingEquipment {
        +uint ID
        +string Name
        +string Description
        +float64 Power
        +float64 Cost
        +string ImageName
        +string VideoName
        +StatusType Status
        +uint CreatorID
        +uint ModeratorID
        +time CreatedAt
        +time FormedAt
        +time FinishedAt
    }

    class HeatingEquipmentLike {
        +uint ID
        +uint UserID
        +uint HeatingEquipmentID
        +time CreatedAt
    }

    class User {
        +uint ID
        +string Login
        +string PasswordHash
        +time CreatedAt
    }

    class HeatingEquipmentSerializer {
        +id
        +name
        +description
        +power
        +cost
        +image_url
        +video_url
        +is_creator
        +liked
        +likes_count
    }

    class CurrentUserSingleton {
        <<singleton>>
        +FixedUserID = 1
        +Get()
    }

    class heating_equipment {
        <<DB table>>
    }
    class heating_equipment_likes {
        <<DB table>>
    }
    class users {
        <<DB table>>
    }

    CatalogPage --> EquipmentDomain
    FeedPage --> EquipmentDomain
    DraftPage --> EquipmentDomain
    RegistrationPage --> UserDomain

    EquipmentDomain --> HeatingEquipment
    EquipmentDomain --> HeatingEquipmentLike
    EquipmentDomain --> HeatingEquipmentSerializer
    EquipmentDomain --> CurrentUserSingleton
    UserDomain --> User

    HeatingEquipment --> heating_equipment
    HeatingEquipmentLike --> heating_equipment_likes
    User --> users
    HeatingEquipment "1" --> "0..*" HeatingEquipmentLike
    User "1" --> "0..*" HeatingEquipment : creator
    User "1" --> "0..*" HeatingEquipmentLike
